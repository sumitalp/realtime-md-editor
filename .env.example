# Application Configuration
NODE_ENV=production
PORT=3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Configuration
JWT_SECRET=change-this-to-a-strong-random-string-min-32-chars

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ECR_REPOSITORY_API=realtime-md-editor-prod-api
AWS_ECR_REPOSITORY_UI=realtime-md-editor-prod-ui
ECS_CLUSTER=realtime-md-editor-prod-cluster
ECS_SERVICE_API=realtime-md-editor-prod-api
S3_BUCKET_UI=realtime-md-editor-prod-ui
CLOUDFRONT_DISTRIBUTION_ID=XXXXXXXXXXXX

# Domain Configuration
API_DOMAIN=api.example.com
UI_DOMAIN=example.com

# Monitoring
ENABLE_CLOUDWATCH=true
CLOUDWATCH_LOG_GROUP=/ecs/realtime-md-editor-prod-api